# Proposed only. Set in the approved Vercel Preview/staging secret store after administrator approval.
# Do not overwrite the working local .env.local. Keep staging and production libraries/roots separate.
# The stable branch address Vercel shows for the staging branch, e.g.
# https://technoedge-assessment-git-staging-<your-scope>.vercel.app
APP_URL=https://YOUR_APPROVED_STAGING_HOST
STORAGE_ADAPTER=graph
GRAPH_TENANT_ID=8b38681f-2496-48ab-8c82-87404e17b322
GRAPH_CLIENT_ID=8bb8f1b0-0729-4057-9e60-32bcac4f909b
GRAPH_CLIENT_SECRET=
GRAPH_SITE_URL=https://technoedgels.sharepoint.com/sites/TechnoEdgeAssessmentROI
GRAPH_SITE_ID=technoedgels.sharepoint.com,a147cfc0-2513-404d-9cd0-fbf64ab48388,3278b77a-2fd1-47f1-887f-7d40c8b903a0
GRAPH_DRIVE_ID=b!wM9HoRMlTUCc0Pv2SrSDiHq3eDLRL_FHiH99QMi5A6CunwqIdk-KS5Ptw251FMgp
GRAPH_STORAGE_ROOT=TechnoEdgeAssessmentROI/Staging
GRAPH_LAYOUT=cohorts-v1
MAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
IDENTITY_PEPPER=
MOCK_AUTH=false
LOCAL_TEST_ACCOUNTS=false
EMAIL_HOURLY_LIMIT=200
OTP_IP_HOURLY_LIMIT=180
ERROR_MONITOR_URL=
ERROR_MONITOR_TOKEN=
# VERCEL=1 is platform-provided. Evidence bytes upload directly to SharePoint.
EVIDENCE_MAX_MIB=25
# VERCEL_ORG_ID / VERCEL_PROJECT_ID / VERCEL_TOKEN belong to an approved operator/CI environment only.

# single (default) = one 60-minute round per room. paired = legacy Base Camp + Summit program creation.
ASSESSMENT_MODE=single
