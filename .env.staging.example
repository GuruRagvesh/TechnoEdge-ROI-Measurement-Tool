# Proposed only. Set in the approved Vercel Preview/staging secret store after administrator approval.
# Do not overwrite the working local .env.local. Keep staging and production libraries/roots separate.
APP_URL=https://YOUR_APPROVED_STAGING_HOST
STORAGE_ADAPTER=graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SITE_URL=https://YOUR_TENANT.sharepoint.com/sites/TechnoEdgeAssessmentROI
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=
GRAPH_STORAGE_ROOT=TechnoEdgeAssessmentROI/Staging
GRAPH_LAYOUT=cohorts-v1
MAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
IDENTITY_PEPPER=
MOCK_AUTH=false
LOCAL_TEST_ACCOUNTS=false
EMAIL_HOURLY_LIMIT=200
OTP_IP_HOURLY_LIMIT=180
ERROR_MONITOR_URL=
ERROR_MONITOR_TOKEN=
# VERCEL=1 is platform-provided. Evidence bytes upload directly to SharePoint.
EVIDENCE_MAX_MIB=25
# VERCEL_ORG_ID / VERCEL_PROJECT_ID / VERCEL_TOKEN belong to an approved operator/CI environment only.
