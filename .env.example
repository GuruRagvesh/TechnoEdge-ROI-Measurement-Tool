# Local quick start: copy this file to .env.local, npm ci, npm run dev.
APP_URL=http://127.0.0.1:3000
STORAGE_ADAPTER=local
LOCAL_STORAGE_PATH=.data
# Available only outside NODE_ENV=production and only with local storage.
MOCK_AUTH=true
# Local only: passwords must be at least 12 characters, configured privately.
LOCAL_TEST_ACCOUNTS=true
TEST_ATTENDEE_PASSWORD=
TEST_HOST_PASSWORD=
# Production: generate a random, stable 32+ byte secret. Changing this breaks email identity links.
IDENTITY_PEPPER=replace-with-a-long-random-secret-before-production

# Production: STORAGE_ADAPTER=graph, MOCK_AUTH=false, APP_URL=https://your-domain
# Graph app-only storage credentials; keep server-side.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_ID=
# TLS SMTP relay for host and attendee verification codes. Never expose development mail in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=TechnoEdge Assessments <assessments@example.com>
EMAIL_HOURLY_LIMIT=200
# Set for your expected cohort/NAT size; the ingress must replace X-Forwarded-For.
OTP_IP_HOURLY_LIMIT=180

# Proposed live configuration; not needed for local mock email.
MAIL_PROVIDER=resend
RESEND_API_KEY=
GRAPH_SITE_ID=
GRAPH_SITE_URL=
GRAPH_STORAGE_ROOT=
GRAPH_LAYOUT=cohorts-v1
ERROR_MONITOR_URL=
ERROR_MONITOR_TOKEN=
# See .env.staging.example and docs/PHASE2_STAGING_READINESS.md before live configuration.

# Maximum evidence file size, in MiB, for both local and direct Graph uploads.
EVIDENCE_MAX_MIB=25

# single (default) = one 60-minute round per room. paired = legacy Base Camp + Summit program creation.
ASSESSMENT_MODE=single

# Live records (sign-in, rooms, answers) in PostgreSQL instead of SharePoint.
# Evidence files and exports stay in SharePoint. Default: graph.
# RECORD_STORE=postgres
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
#   (or POSTGRES_URL, which the Vercel Supabase integration sets; production
#    uses Supabase, Mumbai, connected to Production only)
# DATABASE_SSL=no-verify          # only if the pooler certificate is not publicly trusted
# RECORD_SHAREPOINT_FALLBACK=on   # read records written before the switch
